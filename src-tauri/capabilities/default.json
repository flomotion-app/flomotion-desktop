{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: local page and the hosted FloMotion client",
  "windows": ["main"],
  "remote": {
    "urls": ["https://flomotion.app", "https://*.flomotion.app"]
  },
  "permissions": [
    "core:default",
    "allow-cli-ready",
    "allow-cli-respond"
  ]
}
